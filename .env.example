# Optional overrides for docker compose. To use them:  cp .env.example .env   (.env is gitignored)
# Every value below is also the default, so the stack runs without a .env file.

# Host ports (bound to 127.0.0.1). Change them if 8090 or 5442 is already taken on your machine.
APP_HOST_PORT=8090
POSTGRES_HOST_PORT=5442

# Database (the app container receives these as DB_URL / DB_USER / DB_PASSWORD).
POSTGRES_DB=mor_ledger
POSTGRES_USER=mor
POSTGRES_PASSWORD=mor

# MoR fee as a fraction of the gross amount, in [0, 0.5]. Snapshotted on each payment at capture.
MOR_FEE_RATE=0.05

# Who bears the MoR fee on refunds: MOR_KEEPS_FEE (merchant bears it) or MOR_RETURNS_FEE.
REFUND_FEE_POLICY=MOR_KEEPS_FEE

# How current balances are kept (docs/performance.md). Never changes the numbers, only when reads see them.
# STORED: running balance per account, updated with each posting (exact).
# BATCHED: postings take no account locks; a background refresh folds them into a snapshot that reads return
#          (stale by up to one refresh; see /v1/ledger/lag).
BALANCE_MODE=STORED
# BATCHED only: how often the snapshot is refreshed.
BALANCE_REFRESH_MS=1000
